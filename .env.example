FUNDOPS_ENV=production
FUNDOPS_PROJECT_ID=your-gcp-project-id
FUNDOPS_BIGQUERY_DATASET=fundops
FUNDOPS_MAX_ACCOUNTS=5
FUNDOPS_OPENAI_MODEL=gpt-5-mini
FUNDOPS_CONNECTOR_SALESFORCE_ENABLED=true
FUNDOPS_CONNECTOR_DRIVE_ENABLED=true
FUNDOPS_CONNECTOR_SHEETS_ENABLED=true
FUNDOPS_CONNECTOR_MAILCHIMP_ENABLED=false
FUNDOPS_CONNECTOR_GOOGLE_ADS_ENABLED=false
FUNDOPS_CONNECTOR_HOOTSUITE_ENABLED=false
FUNDOPS_IRS990_ENABLED=false
FUNDOPS_INTAKE_SHEET_ID=your-sheet-id
FUNDOPS_APPROVED_DRIVE_FOLDER_ID=your-folder-id
FUNDOPS_APP_SECRET=replace-me
HOST=0.0.0.0
PORT=8080
# Set RUN_MODE=job to run as a Cloud Run job instead of a service.
RUN_MODE=service
SALESFORCE_USERNAME=your-sf-username@example.com
SALESFORCE_AUTH=your-password+security-token
SALESFORCE_CLIENT_ID=your-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-connected-app-client-secret
