APP_ENV=production
RUN_MODE=service
HOST=0.0.0.0
PORT=8080
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
BQ_DATASET=fundops
ARTIFACT_REGISTRY_REPOSITORY=fundops-intelligence
CLOUD_RUN_SERVICE_NAME=fundops-intelligence
CLOUD_RUN_JOB_NAME=fundops-intelligence-job
CLOUD_SCHEDULER_JOB_NAME=fundops-daily-sync
ENABLE_CLOUD_LOGGING=true
MAX_RECORDS_PER_CONNECTOR=5
FIRST_RUN_CAP=5
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2.0
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_OUTPUT_TOKENS=800
MANUAL_TRIGGER_TOKEN_SECRET=fundops-manual-trigger-token
OPENAI_API_KEY_SECRET=fundops-openai-api-key
SALESFORCE_BASE_URL_SECRET=fundops-salesforce-base-url
SALESFORCE_CLIENT_ID_SECRET=fundops-salesforce-client-id
SALESFORCE_CLIENT_SECRET_SECRET=fundops-salesforce-client-secret
SALESFORCE_USERNAME_SECRET=fundops-salesforce-username
SALESFORCE_PASSWORD_SECRET=fundops-salesforce-password
SALESFORCE_SECURITY_TOKEN_SECRET=fundops-salesforce-security-token
ENABLE_CONNECTOR_SALESFORCE=true
ENABLE_CONNECTOR_GOOGLE_DRIVE=true
GOOGLE_DRIVE_FOLDER_ID=approved-drive-folder-id
ENABLE_CONNECTOR_GOOGLE_SHEETS=true
GOOGLE_SHEETS_SPREADSHEET_ID=sheet-id
GOOGLE_SHEETS_RANGE=Opportunity Intake!A:G
ENABLE_CONNECTOR_MAILCHIMP=false
MAILCHIMP_API_KEY_SECRET=fundops-mailchimp-api-key
MAILCHIMP_SERVER_PREFIX_SECRET=fundops-mailchimp-server-prefix
ENABLE_CONNECTOR_GOOGLE_ADS=false
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN_SECRET=fundops-google-ads-developer-token
GOOGLE_ADS_OAUTH_TOKEN_SECRET=fundops-google-ads-oauth-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
ENABLE_CONNECTOR_HOOTSUITE=false
HOOTSUITE_API_TOKEN_SECRET=fundops-hootsuite-api-token
HOOTSUITE_CSV_PATH=
ENABLE_CONNECTOR_PUBLIC_URLS=false
PUBLIC_URLS=

